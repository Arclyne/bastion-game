<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Networking">
    <PackageVersion Include="CoreWCF.NetTcp" Version="1.9.1" />
    <PackageVersion Include="CoreWCF.Primitives" Version="1.9.1" />
    <PackageVersion Include="System.ServiceModel.NetTcp" Version="10.0.652802" />
    <PackageVersion Include="System.ServiceModel.Primitives" Version="10.0.652802" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="User interface">
    <PackageVersion Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
    <PackageVersion Include="MonoGame.Content.Builder.Task" Version="3.8.5.1" />
  </ItemGroup>

  <ItemGroup Label="Logging">
    <PackageVersion Include="log4net" Version="3.4.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Log4Net.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup Label="Security pins">
    <!-- Transitive dependency of CoreWCF; pinned to a version that fixes CVE-2026-50648. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.12" />
  </ItemGroup>

</Project>
