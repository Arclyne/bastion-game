<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RollForward>Major</RollForward>
    <RootNamespace>Bastion.Client</RootNamespace>
    <NeutralLanguage>en-US</NeutralLanguage>
    <SatelliteResourceLanguages>es-MX</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" />
    <PackageReference Include="MonoGame.Content.Builder.Task" />
    <PackageReference Include="System.ServiceModel.NetTcp" />
    <PackageReference Include="log4net" />
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="Content\Content.mgcb" />
  </ItemGroup>

  <!-- The rules of the game answer the player at once while the move travels to
       the server, which stays the only authority (CU-20 RN-01, RN-07). The client
       still never references the server or the data layer. -->
  <ItemGroup>
    <ProjectReference Include="..\Bastion.Contracts\Bastion.Contracts.csproj" />
    <ProjectReference Include="..\Bastion.Domain\Bastion.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="log4net.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
