<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Bastion.Server.Host</RootNamespace>
    <UserSecretsId>bastion-server-host</UserSecretsId>
  </PropertyGroup>

  <!-- CoreWCF runs on the ASP.NET Core generic host; no HTTP endpoints are exposed. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CoreWCF.NetTcp" />
    <PackageReference Include="CoreWCF.Primitives" />
    <PackageReference Include="log4net" />
    <PackageReference Include="Microsoft.Extensions.Logging.Log4Net.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bastion.Contracts\Bastion.Contracts.csproj" />
    <ProjectReference Include="..\Bastion.Server.Data\Bastion.Server.Data.csproj" />
    <ProjectReference Include="..\Bastion.Server.Services\Bastion.Server.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="log4net.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
